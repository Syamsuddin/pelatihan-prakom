{
  "app": {
    "name": "MyCORPU",
    "description": "Sistem manajemen aktivitas pembelajaran (pelatihan) multi-angkatan: jadwal berbasis JP, presensi per sesi, materi & tugas, pre/post-test, sertifikat ber-QR, laporan",
    "type": "greenfield"
  },
  "confirmed_at": "2026-10-25T13:00:00+08:00",
  "requirements": {
    "goal": "Mengelola siklus pelatihan dari jadwal sampai sertifikat dalam satu aplikasi, menggantikan rekap Excel manual",
    "success_metric": "Sertifikat + laporan akhir terbit <= 1 hari kerja setelah pelatihan ditutup",
    "features": [
      {
        "name": "Kelola pelatihan/angkatan (menit per JP, ambang lulus)",
        "priority": "mvp"
      },
      {
        "name": "Impor peserta dari Excel",
        "priority": "mvp"
      },
      {
        "name": "Materi (total JP) -> sesi terjadwal + penugasan narasumber",
        "priority": "mvp"
      },
      {
        "name": "Presensi per sesi diinput admin/narasumber",
        "priority": "mvp"
      },
      {
        "name": "Bahan ajar unggah/unduh",
        "priority": "mvp"
      },
      {
        "name": "Tugas: unggah jawaban + nilai 0-100",
        "priority": "mvp"
      },
      {
        "name": "Pre/post-test PG per pelatihan",
        "priority": "mvp"
      },
      {
        "name": "Penutupan pelatihan -> kelulusan -> sertifikat PDF + QR verifikasi",
        "priority": "mvp"
      },
      {
        "name": "Laporan Excel/PDF",
        "priority": "mvp"
      },
      {
        "name": "TTE BSrE",
        "priority": "later"
      },
      {
        "name": "Notifikasi email/WA",
        "priority": "later"
      },
      {
        "name": "Evaluasi penyelenggaraan (kuesioner)",
        "priority": "later"
      },
      {
        "name": "Dasbor lintas tahun",
        "priority": "later"
      }
    ],
    "out_of_scope": [
      "Integrasi SIASN/LMS LAN",
      "Video conference/streaming",
      "Presensi QR/geolokasi",
      "Aplikasi mobile native",
      "Pendaftaran mandiri peserta",
      "Multi-bahasa"
    ],
    "roles": [
      {
        "name": "admin",
        "can": [
          "kelola semua pelatihan",
          "impor peserta",
          "kelola materi/sesi/narasumber",
          "presensi semua sesi",
          "kelola bank soal & jendela tes",
          "tutup pelatihan",
          "terbitkan/cabut sertifikat",
          "laporan"
        ],
        "cannot": []
      },
      {
        "name": "narasumber",
        "can": [
          "unggah bahan materi yang ditugaskan",
          "buat tugas & menilai pada materinya",
          "presensi sesi materinya"
        ],
        "cannot": [
          "akses materi/pelatihan lain",
          "tutup pelatihan",
          "kelola peserta",
          "sertifikat"
        ]
      },
      {
        "name": "peserta",
        "can": [
          "lihat jadwal pelatihan yang diikuti",
          "unduh bahan",
          "kumpulkan tugas",
          "kerjakan pre/post-test",
          "unduh sertifikat sendiri"
        ],
        "cannot": [
          "lihat data peserta lain",
          "mengubah presensi",
          "akses pelatihan yang tidak diikuti"
        ]
      }
    ],
    "processes": [
      {
        "name": "Siklus pelatihan",
        "happy_path": "buat pelatihan -> impor peserta -> materi & sesi -> jalankan (presensi, tugas, tes) -> tutup -> sertifikat",
        "failure": "NIP duplikat/tidak valid di Excel; total JP sesi != JP materi; peserta belum post-test saat tutup -> TIDAK LULUS"
      }
    ],
    "pass_rule": "kehadiran >= 80% dari JP (status hadir) DAN post-test >= 70; ambang per pelatihan; tugas tidak menentukan kelulusan",
    "entities": [
      {
        "name": "User",
        "key_attrs": [
          "nip",
          "name",
          "role",
          "must_change_password"
        ],
        "relations": [
          "hasMany Enrollment"
        ]
      },
      {
        "name": "Training",
        "key_attrs": [
          "title",
          "batch",
          "start_date",
          "end_date",
          "minutes_per_jp",
          "min_attendance_pct",
          "min_posttest_score",
          "status"
        ],
        "relations": [
          "hasMany Subject",
          "hasMany Enrollment",
          "hasMany Question"
        ]
      },
      {
        "name": "Enrollment",
        "key_attrs": [
          "training_id",
          "user_id",
          "result"
        ],
        "relations": [
          "hasMany Attendance",
          "hasMany TestAttempt",
          "hasOne Certificate"
        ]
      },
      {
        "name": "Subject",
        "key_attrs": [
          "training_id",
          "title",
          "jp",
          "speaker_id"
        ],
        "relations": [
          "hasMany TrainingSession",
          "hasMany MaterialFile",
          "hasMany Assignment"
        ]
      },
      {
